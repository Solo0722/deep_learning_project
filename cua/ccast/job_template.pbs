#!/bin/bash
# run_id: ${run_id}
#PBS -N ${job_name}
#PBS -q gpus
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:glist=a10
#PBS -l walltime=${walltime}
#PBS -W group_list=x-ccast-prj-aaboah
#PBS -j oe
#PBS -o ${runs_root}/_logs/${run_id}.log

# Generated by cua.ccast.make_jobs. Every job passes --resume, so a plain qsub both starts and
# resumes (e.g. after a deadline stop, exit 3); resubmitting a COMPLETE run exits 0 ("already complete"):
#   qsub ${pbs_path}
set -uo pipefail

cd ${project}/cua_code || exit 1

# conda/venv activate scripts reference unset variables, so nounset is off while activating.
set +u
source /mmfs1/apps/pyenvs/anaconda3-2022.05/etc/profile.d/conda.sh || { echo "conda.sh failed"; exit 1; }
conda activate pytorch || { echo "conda activate pytorch failed"; exit 1; }
source ${project}/.venvs/rdd_detection_v1/bin/activate || { echo "venv activate failed"; exit 1; }
set -u
# COCO weights are pre-downloaded here on a login node (compute nodes may be offline).
export TORCH_HOME=${project}/torch_home
python -c "import torch, torchvision, pycocotools; print(torch.__version__, torchvision.__version__)" || exit 1

echo "run_id: ${run_id}"
echo "started: $$(date -u +%Y-%m-%dT%H:%M:%SZ) on $$(hostname)"
${pytest_block}
# The deadline counts from job start (bash SECONDS), so activation and pytest come out of the margin.
rc=0
python -m cua.run --spec ${run_id} --data-root ${data_root} --runs-root ${runs_root} --deadline-seconds $$(( ${deadline} - SECONDS ))${smoke_args} --resume || rc=$$?

echo "finished: $$(date -u +%Y-%m-%dT%H:%M:%SZ) exit code $$rc"
if [ "$$rc" -eq 3 ]; then
    echo "DEADLINE STOP for ${run_id}: not complete. Resume with:"
    echo "qsub ${pbs_path}"
    exit 3
fi
exit $$rc
