#!/bin/bash
# run_id: ${run_id}
#PBS -N ${job_name}
#PBS -q gpus
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:glist=a10
#PBS -l walltime=${walltime}
#PBS -W group_list=x-ccast-prj-aaboah
#PBS -j oe
#PBS -o ${runs_root}/_logs/${run_id}.log

# Generated by cua.ccast.make_jobs. Resume after a deadline stop (exit 3) with:
#   qsub -v CUA_RESUME=1 ${pbs_path}
set -uo pipefail

cd ${project}/cua_code || exit 1

source /mmfs1/apps/pyenvs/anaconda3-2022.05/etc/profile.d/conda.sh
conda activate pytorch
source ${project}/.venvs/rdd_detection_v1/bin/activate

echo "run_id: ${run_id}"
echo "started: $$(date -u +%Y-%m-%dT%H:%M:%SZ) on $$(hostname)"
${pytest_block}
resume_flag=""
if [ "$${CUA_RESUME:-0}" = "1" ]; then
    resume_flag="--resume"
    echo "CUA_RESUME=1: resuming ${run_id}"
fi

rc=0
python -m cua.run --spec ${run_id} --data-root ${data_root} --runs-root ${runs_root} --deadline-seconds ${deadline}${smoke_args} $$resume_flag || rc=$$?

echo "finished: $$(date -u +%Y-%m-%dT%H:%M:%SZ) exit code $$rc"
if [ "$$rc" -eq 3 ]; then
    echo "DEADLINE STOP for ${run_id}: not complete. Resume with:"
    echo "qsub -v CUA_RESUME=1 ${pbs_path}"
    exit 3
fi
exit $$rc
